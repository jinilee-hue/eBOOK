{"n":2,"file":"p02.mp3","duration":29.969999313354492,"text":"And he set out over the hills to look for one. He climbed over the sunny hills. He trudged through the cool valleys. He walked a long, long time and at last he came to a hill which was quite covered with cats. Cats here, cats there, Cats and kittens everywhere, Hundreds of cats, Thousands of cats, Millions and billions and trillions of cats.","lines":[{"i":0,"c":0,"len":46,"t":0.0,"t1":3.3399999141693115},{"i":1,"c":47,"len":32,"t":4.239999771118164,"t1":6.099999904632568},{"i":2,"c":80,"len":36,"t":6.800000190734863,"t1":8.899999618530273},{"i":3,"c":117,"len":92,"t":9.84000015258789,"t1":17.5},{"i":4,"c":210,"len":22,"t":18.559999465942383,"t1":19.959999084472656},{"i":5,"c":233,"len":28,"t":20.780000686645508,"t1":22.280000686645508},{"i":6,"c":262,"len":17,"t":23.520000457763672,"t1":24.200000762939453},{"i":7,"c":280,"len":18,"t":24.959999084472656,"t1":25.84000015258789},{"i":8,"c":299,"len":44,"t":25.84000015258789,"t1":29.520000457763672}],"words":[{"c":0,"t":0.0,"t1":0.36},{"c":4,"t":0.36,"t1":0.8},{"c":7,"t":0.8,"t1":1.02},{"c":11,"t":1.02,"t1":1.34},{"c":15,"t":1.34,"t1":1.68},{"c":20,"t":1.68,"t1":2.3},{"c":24,"t":2.3,"t1":2.3},{"c":30,"t":2.3,"t1":2.64},{"c":33,"t":2.64,"t1":2.8},{"c":38,"t":2.8,"t1":3.1},{"c":42,"t":3.1,"t1":3.34},{"c":47,"t":4.24,"t1":4.24},{"c":50,"t":4.24,"t1":4.78},{"c":58,"t":4.78,"t1":5.16},{"c":63,"t":5.16,"t1":5.6},{"c":67,"t":5.6,"t1":5.68},{"c":73,"t":5.68,"t1":6.1},{"c":80,"t":6.8,"t1":7.04},{"c":83,"t":7.04,"t1":7.62},{"c":91,"t":7.62,"t1":7.84},{"c":99,"t":7.84,"t1":8.34},{"c":103,"t":8.34,"t1":8.52},{"c":108,"t":8.52,"t1":8.9},{"c":117,"t":9.84,"t1":10.16},{"c":120,"t":10.16,"t1":10.46},{"c":127,"t":10.46,"t1":10.84},{"c":129,"t":10.84,"t1":11.34},{"c":135,"t":11.72,"t1":11.72},{"c":140,"t":11.72,"t1":12.16},{"c":145,"t":12.46,"t1":13.04},{"c":149,"t":13.04,"t1":13.26},{"c":152,"t":13.26,"t1":13.6},{"c":157,"t":13.6,"t1":13.98},{"c":160,"t":13.98,"t1":14.08},{"