{"n":3,"file":"p03.mp3","duration":30.760000228881836,"text":"\"Oh,\" cried the old man joyfully, \"Now I can choose the prettiest cat and take it home with me!\" So he chose one. It was white. But just as he was about to leave, he saw another one all black and white and it seemed just as pretty as the first. So he took this one also. But then he saw a fuzzy grey kitten way over here which was every bit as pretty as the others so he took it too.","lines":[{"i":0,"c":0,"len":96,"t":0.0,"t1":7.440000057220459},{"i":1,"c":97,"len":30,"t":7.800000190734863,"t1":10.34000015258789},{"i":2,"c":128,"len":116,"t":10.680000305175781,"t1":18.600000381469727},{"i":3,"c":245,"len":25,"t":19.0,"t1":20.899999618530273},{"i":4,"c":271,"len":112,"t":21.540000915527344,"t1":29.899999618530273}],"words":[{"c":1,"t":0.0,"t1":0.98},{"c":6,"t":1.68,"t1":1.74},{"c":12,"t":1.74,"t1":1.98},{"c":16,"t":1.98,"t1":2.2},{"c":20,"t":2.2,"t1":2.6},{"c":24,"t":2.6,"t1":3.08},{"c":35,"t":3.72,"t1":4.26},{"c":39,"t":4.26,"t1":4.46},{"c":41,"t":4.46,"t1":4.68},{"c":45,"t":4.68,"t1":4.92},{"c":52,"t":4.92,"t1":5.3},{"c":56,"t":5.3,"t1":5.6},{"c":66,"t":5.6,"t1":6.06},{"c":70,"t":6.06,"t1":6.34},{"c":74,"t":6.34,"t1":6.56},{"c":79,"t":6.56,"t1":6.82},{"c":82,"t":6.82,"t1":6.92},{"c":87,"t":6.92,"t1":7.14},{"c":92,"t":7.14,"t1":7.44},{"c":97,"t":7.8,"t1":8.4},{"c":100,"t":8.4,"t1":8.62},{"c":103,"t":8.62,"t1":8.9},{"c":109,"t":8.9,"t1":9.3},{"c":114,"t":9.68,"t1":9.78},{"c":117,"t":9.78,"t1":10.02},{"c":121,"t":10.02,"t1":10.34},{"c":128,"t":10.68,"t1":11.26},{"c":132,"t":11.26,"t1":11.6},{"c":137,"t":11.6,"t1":11.84},{"c":140,"t":11.84,"t1":11.9},{"c":143,"t":11.9,"t1":12.08},{"c":147,"t":12.08,"t1":12.32},{"c":153,"t":12.32,"t1":12.82},{"c":156,"t":12.82,"t1":12.82},{"c":163,"t":13.0,"t1":13.46},{"c":166,"t":13.46,"t1":13.68},{"c":170,"t":13.68,"t1":14.14},{"c":178,"t":14.14,"t1":14.62},{"c":182,"t":14.9,"t1":15.32},{"c":186,"t":15.32,"t1":15.56},{"c":192,"t":15.56,"t1":15.82},{"c":196,"t":15.82,"t1":