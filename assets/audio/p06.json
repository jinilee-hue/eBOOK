{"n":6,"file":"p06.mp3","duration":42.599998474121094,"text":"They came to a pond. \"Mew, mew! We are thirsty!\" cried the hundreds of cats, thousands of cats, millions and billions and trillions of cats. \"Well, here is a great deal of water,\" said the very old man. Each cat took a sip of water, and the pond was gone! \"Mew, mew! Now we are hungry!\" said the hundreds of cats, thousands of cats, millions and billions and trillions of cats. \"There is much grass on the hills,\" said the very old man. Each cat ate a mouthful of grass and not a blade was left!","lines":[{"i":0,"c":0,"len":20,"t":0.0,"t1":2.0},{"i":1,"c":21,"len":119,"t":3.240000009536743,"t1":12.579999923706055},{"i":2,"c":141,"len":61,"t":13.199999809265137,"t1":17.860000610351562},{"i":3,"c":203,"len":52,"t":18.700000762939453,"t1":22.520000457763672},{"i":4,"c":256,"len":121,"t":23.600000381469727,"t1":32.540000915527344},{"i":5,"c":378,"len":58,"t":33.47999954223633,"t1":36.91999816894531},{"i":6,"c":437,"len":58,"t":37.880001068115234,"t1":41.81999969482422}],"words":[{"c":0,"t":0.0,"t1":0.44},{"c":5,"t":0.44,"t1":0.98},{"c":10,"t":0.98,"t1":1.28},{"c":13,"t":1.28,"t1":2.0},{"c":15,"t":2.0,"t1":2.0},{"c":22,"t":3.24,"t1":3.54},{"c":27,"t":3.86,"t1":3.96},{"c":32,"t":4.16,"t1":4.68},{"c":35,"t":4.68,"t1":5.06},{"c":39,"t":5.06,"t1":5.46},{"c":49,"t":6.36,"t1":6.36},{"c":55,"t":6.36,"t1":6.66},{"c":59,"t":6.66,"t1":7.02},{"c":68,"t":7.02,"t1":7.66},{"c":71,"t":7.66,"t1":7.66},{"c":77,"t":8.4,"t1":8.46},{"c":87,"t":8.46,"t1":9.14},{"c":90,"t":9.14,"t1":9.14},{"c":96,"t":9.84,"t1":10.0},{"c":105,"t":10.0,"t1":10.6},{"c":109,"t":10.6,"t1":10.84},{"c":118,"t":10.84,"t1":11.42},{"c":122,"t":11.42,"t1":11.72},{"c":132,"t":11.72,"t1":12.58},{"c":135,"t":12.58,"t1":12.58},{"c":142,"t":13.2,"t1":13.92},{"c":148,"t":14.1,"t1":14.62},{"c":153,"t":14.62,"t1":14.8},{"c":156,"t":14.8,"t1":15.04},{"c":158,"t":15.04,"t1":15.38},{"c":164,"t":15.38,"t1":15.62},{"c":169,"t":15.62,"t1":16.2},{"c":172,"t":16.2,"t1":16