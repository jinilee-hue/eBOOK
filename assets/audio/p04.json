{"n":4,"file":"p04.mp3","duration":35.540000915527344,"text":"And now he saw one way down in a corner which he thought too lovely to leave so he took this too. And just then, over here, the very old man found a kitten, which was black and very beautiful. \"It would be a shame to leave that one,\" said the very old man. So he took it. And now, over there, he saw a cat which had brown and yellow stripes like a baby tiger. \"I simply must take it!\" cried the very old man, and he did.","lines":[{"i":0,"c":0,"len":97,"t":0.0,"t1":8.34000015258789},{"i":1,"c":98,"len":94,"t":9.039999961853027,"t1":16.600000381469727},{"i":2,"c":193,"len":78,"t":17.399999618530273,"t1":22.920000076293945},{"i":3,"c":272,"len":87,"t":23.15999984741211,"t1":29.540000915527344},{"i":4,"c":360,"len":60,"t":30.3799991607666,"t1":34.939998626708984}],"words":[{"c":0,"t":0.0,"t1":0.34},{"c":4,"t":0.34,"t1":0.94},{"c":8,"t":0.94,"t1":1.36},{"c":11,"t":1.36,"t1":1.66},{"c":15,"t":1.66,"t1":2.16},{"c":19,"t":2.16,"t1":2.76},{"c":23,"t":2.76,"t1":3.16},{"c":28,"t":3.16,"t1":3.32},{"c":31,"t":3.32,"t1":3.86},{"c":33,"t":3.86,"t1":3.86},{"c":40,"t":3.86,"t1":4.48},{"c":46,"t":4.48,"t1":4.82},{"c":49,"t":4.82,"t1":5.08},{"c":57,"t":5.08,"t1":5.58},{"c":61,"t":5.58,"t1":5.82},{"c":68,"t":5.82,"t1":6.22},{"c":71,"t":6.22,"t1":6.52},{"c":77,"t":6.92,"t1":7.06},{"c":80,"t":7.06,"t1":7.4},{"c":83,"t":7.4,"t1":7.6},{"c":88,"t":7.6,"t1":8.0},{"c":93,"t":8.0,"t1":8.34},{"c":98,"t":9.04,"t1":9.56},{"c":102,"t":9.56,"t1":9.86},{"c":107,"t":9.86,"t1":10.3},{"c":113,"t":10.56,"t1":10.96},{"c":118,"t":10.96,"t1":11.44},{"c":124,"t":11.78,"t1":12.0},{"c":128,"t":12.0,"t1":12.38},{"c":133,"t":12.38,"t1":12.72},{"c":137,"t":12.72,"t1":13.06},{"c":141,"t":13.06,"t1":13.4},{"c":147,"t":13.4,"t1":13.92},{"c":149,"t":13.92,"t1":13.92},{"c":157,"t":13.92,"t1":14.44},{"c":163,"t":14.44,"t1":14.76},{"c":167,"t":14.76,"t1":15.18},{"c":173,"t":15.18,"t1":15.72},{"c":177,"t":15.72,"t1":16.16},{"c":182,"t":16.16,"t1":16.6},{"c":